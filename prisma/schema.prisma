generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PASANTE
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  TARDANZA
  PERMISO
  AJUSTE_ADMIN
}

enum AuditAction {
  LOGIN
  LOGIN_FAILED
  LOGOUT
  CHANGE_PASSWORD
  CREATE_USER
  UPDATE_USER
  DEACTIVATE_USER
  CREATE_PASANTE
  UPDATE_PASANTE
  DELETE_PASANTE
  CREATE_PLACE
  UPDATE_PLACE
  DELETE_PLACE
  CHECKIN
  CHECKOUT
  ADMIN_ADJUST_ATTENDANCE
  EXPORT_REPORT
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  password           String
  name               String
  role               Role      @default(PASANTE)
  mustChangePassword Boolean   @default(true)
  tokenVersion       Int       @default(0)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz
  deletedAt          DateTime? @db.Timestamptz
  pasante            Pasante?
  auditLogs          AdminLog[]
  devices            Device[]

  @@index([email])
  @@index([role, active])
}

model Place {
  id        String    @id @default(uuid())
  name      String
  lat       Float
  lng       Float
  radius    Float
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz
  updatedAt DateTime  @updatedAt @db.Timestamptz
  deletedAt DateTime? @db.Timestamptz
  pasantes  Pasante[]
}

model Pasante {
  id          String    @id @default(uuid())
  userId      String    @unique
  cedula      String    @unique
  institucion String?
  carrera     String?
  horario     Json?
  placeId     String?
  fechaInicio DateTime  @db.Timestamptz
  fechaFin    DateTime? @db.Timestamptz
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz
  updatedAt   DateTime  @updatedAt @db.Timestamptz
  deletedAt   DateTime? @db.Timestamptz
  user        User      @relation(fields: [userId], references: [id])
  place       Place?    @relation(fields: [placeId], references: [id])
  attendance  Attendance[]

  @@index([userId])
  @@index([placeId])
  @@index([activo])
}

model Attendance {
  id          String           @id @default(uuid())
  pasanteId   String
  fecha       DateTime         @db.Date
  horaEntrada DateTime?        @db.Timestamptz
  horaSalida  DateTime?        @db.Timestamptz
  latitud     Float?
  longitud    Float?
  status      AttendanceStatus @default(PRESENTE)
  nota        String?
  deviceId    String?
  createdBy   String?
  createdAt   DateTime         @default(now()) @db.Timestamptz
  updatedAt   DateTime         @updatedAt @db.Timestamptz
  pasante     Pasante          @relation(fields: [pasanteId], references: [id])
  device      Device?          @relation(fields: [deviceId], references: [id])

  @@unique([pasanteId, fecha])
  @@index([pasanteId, fecha])
  @@index([fecha, status])
}

model AdminLog {
  id         String      @id @default(uuid())
  actorId    String?
  actorRole  Role?
  action     AuditAction
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime    @default(now()) @db.Timestamptz
  actor      User?       @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model Device {
  id         String       @id @default(uuid())
  userId     String
  platform   String
  pushToken  String?      @unique
  deviceName String?
  lastSeenAt DateTime     @default(now()) @db.Timestamptz
  createdAt  DateTime     @default(now()) @db.Timestamptz
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendance Attendance[]

  @@index([userId])
}
